#!/usr/bin/env python3
"""Run E-path from a clone of the repository without installing anything."""

import importlib.util
import sys
from pathlib import Path

MINIMUM_PYTHON = (3, 14)
REQUIRED_MODULES = ("gemmi", "numpy", "scipy", "matplotlib")


def main() -> int:
    """Check the Python version and libraries, then run the E-path command line."""
    # This file is kept to syntax old interpreters can read, so that one of
    # them reports the requirement instead of a syntax error from the package.
    if sys.version_info < MINIMUM_PYTHON:
        print(
            "epath: Python {}.{} or newer is required, but this is Python {}.{}.".format(
                *MINIMUM_PYTHON, *sys.version_info[:2]
            ),
            file=sys.stderr,
        )
        return 1

    missing = [m for m in REQUIRED_MODULES if importlib.util.find_spec(m) is None]
    if missing:
        print(f"epath: missing required libraries: {' '.join(missing)}", file=sys.stderr)
        print(
            "Install the packages listed in requirements.txt however you "
            "prefer (pip, apt, conda, ...), then rerun.",
            file=sys.stderr,
        )
        return 1

    sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))
    from epath.cli import main as epath_main

    return epath_main()


if __name__ == "__main__":
    raise SystemExit(main())
